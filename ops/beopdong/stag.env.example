BEOPDONG_APP_IMAGE=ghcr.io/gujeuk-check-in/beopdong-api:stag-replace-with-commit-sha
BEOPDONG_APP_CONTAINER_NAME=beopdong-app-stag
BEOPDONG_APP_PORT=8082

BEOPDONG_MYSQL_CONTAINER_NAME=beopdong-mysql-stag
BEOPDONG_MYSQL_DATABASE=beopdong_stag
BEOPDONG_MYSQL_USER=beopdong_app
BEOPDONG_MYSQL_PASSWORD=change-me-stag-beopdong-db-password
BEOPDONG_MYSQL_ROOT_PASSWORD=change-me-stag-beopdong-root-password
BEOPDONG_MYSQL_VOLUME_NAME=beopdong-stag-mysql-data

BEOPDONG_DB_URL=jdbc:mysql://beopdong-mysql:3306/beopdong_stag?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
BEOPDONG_JAVA_OPTS=-Xms64m -Xmx256m

BEOPDONG_JWT_SECRET_KEY=change-me-beopdong-jwt-secret
