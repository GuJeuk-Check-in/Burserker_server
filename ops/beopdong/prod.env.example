BEOPDONG_APP_IMAGE=ghcr.io/gujeuk-check-in/beopdong-api:prod-replace-with-commit-sha
BEOPDONG_APP_CONTAINER_NAME=beopdong-app-prod
BEOPDONG_APP_PORT=8083

BEOPDONG_MYSQL_CONTAINER_NAME=beopdong-mysql-prod
BEOPDONG_MYSQL_DATABASE=beopdong_prod
BEOPDONG_MYSQL_USER=beopdong_app
BEOPDONG_MYSQL_PASSWORD=change-me-prod-beopdong-db-password
BEOPDONG_MYSQL_ROOT_PASSWORD=change-me-prod-beopdong-root-password
BEOPDONG_MYSQL_VOLUME_NAME=beopdong-prod-mysql-data

BEOPDONG_DB_URL=jdbc:mysql://beopdong-mysql:3306/beopdong_prod?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
BEOPDONG_JAVA_OPTS=-Xms64m -Xmx256m

BEOPDONG_JWT_SECRET_KEY=change-me-beopdong-jwt-secret
